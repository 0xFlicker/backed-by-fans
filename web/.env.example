# Server-only RPC endpoints used to render onchain state into the first HTML
# response. These values may contain paid credentials and must never use the
# NEXT_PUBLIC_ prefix. Factory addresses come from Wagmi-generated contracts.
ROBINHOOD_MAINNET_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=

# The remaining NEXT_PUBLIC_ values are intentionally embedded in the browser
# bundle. Never put a secret or private RPC credential in one of them.

# Optional WalletConnect project identifier. Injected EIP-1193 wallets remain
# available without it; generic WalletConnect appears only when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical public origin used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Disposable chain-31337 browser testing. Set all three together. The
# repository Anvil harness supplies these automatically; public builds do not.
NEXT_PUBLIC_ANVIL_RPC_URL=
NEXT_PUBLIC_ANVIL_FACTORY_ADDRESS=
NEXT_PUBLIC_ANVIL_USDG_ADDRESS=
