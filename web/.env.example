# Every value in this file is intentionally public and is embedded in the
# browser bundle at build time. Never put a secret or private RPC credential in
# a NEXT_PUBLIC_ variable.

# 46630 (testnet) or 4663 (mainnet). Defaults to testnet when omitted.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630

# Official factory deployment for the selected chain. Leave empty until a
# deployment manifest has been independently checked. The app will show a
# distinct "not deployed" state rather than inventing an address.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Canonical USDG proxy for the selected chain. Mainnet is checked against the
# official fixed address. Testnet must remain empty until an approved official
# source publishes the canonical proxy.
NEXT_PUBLIC_USDG_ADDRESS=

# Optional public RPC overrides. Public endpoints are used when omitted.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=

# Optional public WalletConnect project identifier. Injected EIP-1193 wallets
# remain available without it; generic WalletConnect appears only when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical public origin used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
