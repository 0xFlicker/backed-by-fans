# Every value in this file is intentionally public and is embedded in the
# browser bundle at build time. Never put a secret or private RPC credential in
# a NEXT_PUBLIC_ variable.

# 46630 (testnet) or 4663 (mainnet). Defaults to testnet when omitted.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630

# Official factory deployment for the selected chain. Leave empty until a
# deployment manifest has been independently checked. The app will show a
# distinct "not deployed" state rather than inventing an address.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Official USDG proxy for the selected chain. The application pins both chain
# addresses and rejects any supplied value that differs from the selected one.
# This default is the official Robinhood testnet proxy.
NEXT_PUBLIC_USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F

# Exact commitments copied from the independently checked, signed deployment
# record. The contract runtime hashes plus USDG implementation address/hash are
# all required; addresses and same-shaped interfaces alone never enable writes.
NEXT_PUBLIC_FACTORY_RUNTIME_CODE_HASH=
NEXT_PUBLIC_RENDERER_RUNTIME_CODE_HASH=
NEXT_PUBLIC_DEPLOYER_RUNTIME_CODE_HASH=
NEXT_PUBLIC_USDG_RUNTIME_CODE_HASH=
NEXT_PUBLIC_USDG_IMPLEMENTATION_ADDRESS=
NEXT_PUBLIC_USDG_IMPLEMENTATION_RUNTIME_CODE_HASH=

# Optional public RPC overrides. Public endpoints are used when omitted.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=

# Optional public WalletConnect project identifier. Injected EIP-1193 wallets
# remain available without it; generic WalletConnect appears only when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical public origin used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
