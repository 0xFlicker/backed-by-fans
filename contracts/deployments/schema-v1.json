{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backed-by-fans.invalid/deployments/schema-v1.json",
  "title": "Backed By Fans protocol deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "network", "chainId"],
  "properties": {
    "$schema": { "const": "./schema-v1.json" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["blocked", "deployed"] },
    "network": { "enum": ["robinhood-testnet", "robinhood-mainnet"] },
    "chainId": { "enum": [46630, 4663] },
    "blocker": { "type": "string", "minLength": 1 },
    "rendererCreationBlockNumber": { "type": "integer", "minimum": 1 },
    "factoryCreationBlockNumber": { "type": "integer", "minimum": 1 },
    "validationTierCreationBlockNumber": { "type": "integer", "minimum": 1 },
    "capturedBlockNumber": { "type": "integer", "minimum": 1 },
    "capturedBlockHash": { "$ref": "#/$defs/hash" },
    "factoryDeploymentTransactionHash": { "$ref": "#/$defs/hash" },
    "validationTierCreationTransactionHash": { "$ref": "#/$defs/hash" },
    "factoryDeploymentInputHash": { "$ref": "#/$defs/hash" },
    "validationTierCreationInputHash": { "$ref": "#/$defs/hash" },
    "paymentToken": { "$ref": "#/$defs/address" },
    "paymentTokenName": { "type": "string", "minLength": 1 },
    "paymentTokenSymbol": { "const": "USDG" },
    "paymentTokenDecimals": { "const": 6 },
    "protocolOwner": { "$ref": "#/$defs/address" },
    "pendingProtocolOwner": { "$ref": "#/$defs/address" },
    "feeRecipient": { "$ref": "#/$defs/address" },
    "renderer": { "$ref": "#/$defs/address" },
    "factory": { "$ref": "#/$defs/address" },
    "deployer": { "$ref": "#/$defs/address" },
    "creationCodeStoreA": { "$ref": "#/$defs/address" },
    "creationCodeStoreB": { "$ref": "#/$defs/address" },
    "validationTier": { "$ref": "#/$defs/address" },
    "validationTierOwner": { "$ref": "#/$defs/address" },
    "validationTierIndex": { "type": "integer", "minimum": 0 },
    "paymentTokenRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "rendererRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "factoryRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "deployerRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "creationCodeStoreARuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "creationCodeStoreBRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "validationTierRuntimeCodeHash": { "$ref": "#/$defs/hash" },
    "rendererCreationCodeHash": { "$ref": "#/$defs/hash" },
    "factoryCreationCodeHash": { "$ref": "#/$defs/hash" },
    "tierCreationCodeHash": { "$ref": "#/$defs/hash" },
    "validationTierConfigHash": { "$ref": "#/$defs/hash" },
    "validationTierName": { "type": "string", "minLength": 1 },
    "validationTierSymbol": { "type": "string", "minLength": 1 },
    "validationTierDescription": { "type": "string" },
    "validationTierImageURI": { "type": "string" },
    "validationTierExternalURI": { "type": "string" },
    "validationTierPricePerPeriod": { "type": "integer", "minimum": 0 },
    "validationTierPeriodDuration": { "type": "integer", "minimum": 1 },
    "validationTierRewardBps": { "type": "integer", "minimum": 0, "maximum": 9900 },
    "validationTierReferralBps": { "type": "integer", "minimum": 0, "maximum": 9900 },
    "validationTierSupplyCap": { "type": "integer", "minimum": 0 },
    "validationTierMaxPrepaidPeriods": { "type": "integer", "minimum": 0 },
    "foundryVersion": { "const": "1.7.1" },
    "solcVersion": { "const": "0.8.36" },
    "evmVersion": { "const": "cancun" },
    "optimizerEnabled": { "const": true },
    "optimizerRuns": { "const": 200 },
    "bytecodeHash": { "const": "ipfs" },
    "rendererVerificationUrl": { "type": "string", "minLength": 1 },
    "factoryVerificationUrl": { "type": "string", "minLength": 1 },
    "deployerVerificationUrl": { "type": "string", "minLength": 1 },
    "creationCodeStoreAVerificationUrl": { "type": "string", "minLength": 1 },
    "creationCodeStoreBVerificationUrl": { "type": "string", "minLength": 1 },
    "validationTierVerificationUrl": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "properties": { "status": { "const": "blocked" } },
      "required": ["blocker"]
    },
    {
      "properties": { "status": { "const": "deployed" } },
      "required": [
        "rendererCreationBlockNumber",
        "factoryCreationBlockNumber",
        "validationTierCreationBlockNumber",
        "capturedBlockNumber",
        "capturedBlockHash",
        "factoryDeploymentTransactionHash",
        "validationTierCreationTransactionHash",
        "factoryDeploymentInputHash",
        "validationTierCreationInputHash",
        "paymentToken",
        "paymentTokenName",
        "paymentTokenSymbol",
        "paymentTokenDecimals",
        "protocolOwner",
        "pendingProtocolOwner",
        "feeRecipient",
        "renderer",
        "factory",
        "deployer",
        "creationCodeStoreA",
        "creationCodeStoreB",
        "validationTier",
        "validationTierOwner",
        "validationTierIndex",
        "paymentTokenRuntimeCodeHash",
        "rendererRuntimeCodeHash",
        "factoryRuntimeCodeHash",
        "deployerRuntimeCodeHash",
        "creationCodeStoreARuntimeCodeHash",
        "creationCodeStoreBRuntimeCodeHash",
        "validationTierRuntimeCodeHash",
        "rendererCreationCodeHash",
        "factoryCreationCodeHash",
        "tierCreationCodeHash",
        "validationTierConfigHash",
        "validationTierName",
        "validationTierSymbol",
        "validationTierDescription",
        "validationTierImageURI",
        "validationTierExternalURI",
        "validationTierPricePerPeriod",
        "validationTierPeriodDuration",
        "validationTierRewardBps",
        "validationTierReferralBps",
        "validationTierSupplyCap",
        "validationTierMaxPrepaidPeriods",
        "foundryVersion",
        "solcVersion",
        "evmVersion",
        "optimizerEnabled",
        "optimizerRuns",
        "bytecodeHash",
        "rendererVerificationUrl",
        "factoryVerificationUrl",
        "deployerVerificationUrl",
        "creationCodeStoreAVerificationUrl",
        "creationCodeStoreBVerificationUrl",
        "validationTierVerificationUrl"
      ]
    }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
