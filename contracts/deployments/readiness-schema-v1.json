{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backed-by-fans.invalid/deployments/readiness-schema-v1.json",
  "title": "Backed By Fans signed release-readiness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "candidateId",
    "status",
    "network",
    "chainId",
    "deploymentManifest",
    "gates",
    "signatures"
  ],
  "properties": {
    "$schema": { "const": "./readiness-schema-v1.json" },
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["blocked", "ready", "superseded"] },
    "network": { "enum": ["robinhood-testnet", "robinhood-mainnet"] },
    "chainId": { "enum": [46630, 4663] },
    "deploymentManifest": { "type": "string", "minLength": 1 },
    "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "$ref": "#/$defs/gitCommit" },
    "sourceTreeSha256": { "$ref": "#/$defs/sha256" },
    "dependencyLockSha256": { "$ref": "#/$defs/sha256" },
    "standardJsonInputSha256": { "$ref": "#/$defs/sha256" },
    "standardJsonOutputSha256": { "$ref": "#/$defs/sha256" },
    "contractArtifactsSha256": { "$ref": "#/$defs/sha256" },
    "webArtifactSha256": { "$ref": "#/$defs/sha256" },
    "observedDeployment": { "$ref": "#/$defs/observedDeployment" },
    "operations": { "$ref": "#/$defs/operations" },
    "foundryVersion": { "const": "1.7.1" },
    "solcVersion": { "const": "0.8.36" },
    "evmVersion": { "const": "cancun" },
    "optimizerEnabled": { "const": true },
    "optimizerRuns": { "const": 200 },
    "bytecodeHash": { "const": "ipfs" },
    "frozenAtUtc": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string", "minLength": 1 },
    "supersededBy": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalToken",
        "publicPilot",
        "brandClearance",
        "artifactFreeze",
        "accountingReview",
        "securityAudit",
        "reproducibleBuild",
        "safeReadiness",
        "deploymentVerification",
        "monitoringReadiness",
        "humanAuthorization"
      ],
      "properties": {
        "canonicalToken": { "$ref": "#/$defs/gate" },
        "publicPilot": { "$ref": "#/$defs/gate" },
        "brandClearance": { "$ref": "#/$defs/gate" },
        "artifactFreeze": { "$ref": "#/$defs/gate" },
        "accountingReview": { "$ref": "#/$defs/gate" },
        "securityAudit": { "$ref": "#/$defs/gate" },
        "reproducibleBuild": { "$ref": "#/$defs/gate" },
        "safeReadiness": { "$ref": "#/$defs/gate" },
        "deploymentVerification": { "$ref": "#/$defs/gate" },
        "monitoringReadiness": { "$ref": "#/$defs/gate" },
        "humanAuthorization": { "$ref": "#/$defs/gate" }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "signer",
          "scheme",
          "digest",
          "signature",
          "signedAtUtc"
        ],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "signer": { "type": "string", "minLength": 1 },
          "scheme": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/sha256" },
          "signature": { "type": "string", "minLength": 1 },
          "signedAtUtc": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": {
        "required": [
          "deploymentManifestSha256",
          "sourceCommit",
          "sourceTreeSha256",
          "dependencyLockSha256",
          "standardJsonInputSha256",
          "standardJsonOutputSha256",
          "contractArtifactsSha256",
          "webArtifactSha256",
          "observedDeployment",
          "operations",
          "foundryVersion",
          "solcVersion",
          "evmVersion",
          "optimizerEnabled",
          "optimizerRuns",
          "bytecodeHash",
          "frozenAtUtc"
        ],
        "properties": {
          "network": {
            "const": "robinhood-mainnet"
          },
          "chainId": {
            "const": 4663
          },
          "gates": {
            "properties": {
              "canonicalToken": { "$ref": "#/$defs/readyGate" },
              "publicPilot": { "$ref": "#/$defs/readyGate" },
              "brandClearance": { "$ref": "#/$defs/readyGate" },
              "artifactFreeze": { "$ref": "#/$defs/readyGate" },
              "accountingReview": { "$ref": "#/$defs/readyGate" },
              "securityAudit": { "$ref": "#/$defs/readyGate" },
              "reproducibleBuild": { "$ref": "#/$defs/readyGate" },
              "safeReadiness": { "$ref": "#/$defs/readyGate" },
              "deploymentVerification": { "$ref": "#/$defs/readyGate" },
              "monitoringReadiness": { "$ref": "#/$defs/readyGate" },
              "humanAuthorization": { "$ref": "#/$defs/readyGate" }
            }
          },
          "signatures": { "minItems": 2 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } } },
      "then": { "required": ["supersededBy"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["OPEN", "BLOCKED", "PASS"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "owner": { "type": "string", "minLength": 1 },
        "reviewedAtUtc": { "type": "string", "format": "date-time" },
        "blocker": { "type": "string", "minLength": 1 }
      }
    },
    "readyGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "required": ["owner", "reviewedAtUtc"],
          "properties": {
            "status": { "const": "PASS" },
            "evidence": { "minItems": 1 }
          }
        }
      ]
    },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "chainHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "observedDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedBlockNumber",
        "capturedBlockHash",
        "transactionHashes",
        "deploymentProvenance",
        "webPublicConfig",
        "constructorInputs",
        "constructorInputsSha256",
        "creationCodeHashes",
        "runtimeCodeHashes",
        "factoryRegistration",
        "usdG",
        "protocolControl",
        "multisig",
        "accountingReview",
        "securityAudit",
        "sourceVerificationUrls",
        "postDeploySmokeEvidence"
      ],
      "properties": {
        "capturedBlockNumber": { "type": "integer", "minimum": 1 },
        "capturedBlockHash": { "$ref": "#/$defs/chainHash" },
        "transactionHashes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/chainHash" }
        },
        "deploymentProvenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factoryDeploymentTransactionHash",
            "factoryDeploymentInputHash",
            "validationTierCreationTransactionHash",
            "validationTierCreationInputHash",
            "verifiedAtBlock"
          ],
          "properties": {
            "factoryDeploymentTransactionHash": { "$ref": "#/$defs/chainHash" },
            "factoryDeploymentInputHash": { "$ref": "#/$defs/chainHash" },
            "validationTierCreationTransactionHash": {
              "$ref": "#/$defs/chainHash"
            },
            "validationTierCreationInputHash": { "$ref": "#/$defs/chainHash" },
            "verifiedAtBlock": { "type": "integer", "minimum": 1 }
          }
        },
        "webPublicConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainId",
            "factoryAddress",
            "factoryRuntimeCodeHash",
            "rendererRuntimeCodeHash",
            "deployerRuntimeCodeHash",
            "usdGRuntimeCodeHash",
            "usdGImplementationAddress",
            "usdGImplementationRuntimeCodeHash"
          ],
          "properties": {
            "chainId": { "enum": [46630, 4663] },
            "factoryAddress": { "$ref": "#/$defs/address" },
            "factoryRuntimeCodeHash": { "$ref": "#/$defs/chainHash" },
            "rendererRuntimeCodeHash": { "$ref": "#/$defs/chainHash" },
            "deployerRuntimeCodeHash": { "$ref": "#/$defs/chainHash" },
            "usdGRuntimeCodeHash": { "$ref": "#/$defs/chainHash" },
            "usdGImplementationAddress": { "$ref": "#/$defs/address" },
            "usdGImplementationRuntimeCodeHash": { "$ref": "#/$defs/chainHash" }
          }
        },
        "constructorInputs": { "$ref": "#/$defs/constructorInputs" },
        "constructorInputsSha256": { "$ref": "#/$defs/sha256" },
        "creationCodeHashes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/chainHash" },
          "required": ["renderer", "factory", "tier"]
        },
        "runtimeCodeHashes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/chainHash" },
          "required": [
            "paymentToken",
            "renderer",
            "factory",
            "deployer",
            "creationCodeStoreA",
            "creationCodeStoreB",
            "launchTier"
          ]
        },
        "factoryRegistration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factory",
            "tier",
            "tierIndex",
            "registered",
            "observedAtBlock"
          ],
          "properties": {
            "factory": { "$ref": "#/$defs/address" },
            "tier": { "$ref": "#/$defs/address" },
            "tierIndex": { "type": "integer", "minimum": 0 },
            "registered": { "const": true },
            "observedAtBlock": { "type": "integer", "minimum": 1 }
          }
        },
        "usdG": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proxy",
            "implementation",
            "authority",
            "decimals",
            "paused",
            "proxyCodeHash",
            "implementationCodeHash",
            "observedAtBlock",
            "observedBlockHash"
          ],
          "properties": {
            "proxy": { "$ref": "#/$defs/address" },
            "implementation": { "$ref": "#/$defs/address" },
            "authority": { "$ref": "#/$defs/address" },
            "decimals": { "const": 6 },
            "paused": { "type": "boolean" },
            "proxyCodeHash": { "$ref": "#/$defs/chainHash" },
            "implementationCodeHash": { "$ref": "#/$defs/chainHash" },
            "observedAtBlock": { "type": "integer", "minimum": 1 },
            "observedBlockHash": { "$ref": "#/$defs/chainHash" }
          }
        },
        "protocolControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "pendingOwner", "feeRecipient"],
          "properties": {
            "owner": { "$ref": "#/$defs/address" },
            "pendingOwner": { "$ref": "#/$defs/address" },
            "feeRecipient": { "$ref": "#/$defs/address" }
          }
        },
        "multisig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "runtimeCodeHash",
            "owners",
            "threshold",
            "modules",
            "guard",
            "fallbackHandler"
          ],
          "properties": {
            "address": { "$ref": "#/$defs/address" },
            "runtimeCodeHash": { "$ref": "#/$defs/chainHash" },
            "owners": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/address" }
            },
            "threshold": { "type": "integer", "minimum": 2 },
            "modules": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/address" }
            },
            "guard": { "$ref": "#/$defs/address" },
            "fallbackHandler": { "$ref": "#/$defs/address" }
          }
        },
        "accountingReview": { "$ref": "#/$defs/review" },
        "securityAudit": { "$ref": "#/$defs/review" },
        "sourceVerificationUrls": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "postDeploySmokeEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportSha256",
        "scope",
        "artifactSha256",
        "finalDisposition"
      ],
      "properties": {
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "scope": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "finalDisposition": { "type": "string", "minLength": 1 }
      }
    },
    "constructorInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "factory", "deployer", "launchTier"],
      "properties": {
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments"],
          "properties": { "arguments": { "const": [] } }
        },
        "factory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paymentToken",
            "renderer",
            "initialOwner",
            "initialFeeRecipient"
          ],
          "properties": {
            "paymentToken": { "$ref": "#/$defs/address" },
            "renderer": { "$ref": "#/$defs/address" },
            "initialOwner": { "$ref": "#/$defs/address" },
            "initialFeeRecipient": { "$ref": "#/$defs/address" }
          }
        },
        "deployer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["factory", "renderer"],
          "properties": {
            "factory": { "$ref": "#/$defs/address" },
            "renderer": { "$ref": "#/$defs/address" }
          }
        },
        "launchTier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factory",
            "paymentToken",
            "renderer",
            "creator",
            "name",
            "symbol",
            "pricePerPeriod",
            "periodDuration",
            "rewardBps",
            "referralBps",
            "supplyCap",
            "maxPrepaidPeriods",
            "description",
            "imageURI",
            "externalURI"
          ],
          "properties": {
            "factory": { "$ref": "#/$defs/address" },
            "paymentToken": { "$ref": "#/$defs/address" },
            "renderer": { "$ref": "#/$defs/address" },
            "creator": { "$ref": "#/$defs/address" },
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "pricePerPeriod": { "type": "integer", "minimum": 0 },
            "periodDuration": { "type": "integer", "minimum": 1 },
            "rewardBps": { "type": "integer", "minimum": 0, "maximum": 9900 },
            "referralBps": { "type": "integer", "minimum": 0, "maximum": 9900 },
            "supplyCap": { "type": "integer", "minimum": 0 },
            "maxPrepaidPeriods": { "type": "integer", "minimum": 0 },
            "description": { "type": "string" },
            "imageURI": { "type": "string" },
            "externalURI": { "type": "string" }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentContacts",
        "confirmationPolicy",
        "productionRpcProviders",
        "vercelProject",
        "productionHost",
        "launchCreator",
        "publicSupersessionWording"
      ],
      "properties": {
        "incidentContacts": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmationPolicy": { "type": "string", "minLength": 1 },
        "productionRpcProviders": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "vercelProject": { "type": "string", "minLength": 1 },
        "productionHost": { "type": "string", "format": "hostname" },
        "launchCreator": { "type": "string", "minLength": 1 },
        "publicSupersessionWording": { "type": "string", "minLength": 1 }
      }
    }
  }
}
