#!/usr/bin/env bash
set -euo pipefail
printf 'cast %s\n' "$*" >>"$MOCK_LOG"
case "${1:-} ${2:-}" in
  "chain-id --rpc-url")
    printf '%s\n' "$MOCK_CHAIN_ID"
    ;;
  "wallet address")
    printf '%s\n' "$MOCK_DEPLOYER"
    ;;
  "to-check-sum-address 0x1111111111111111111111111111111111111111")
    printf '%s\n' "0x1111111111111111111111111111111111111111"
    ;;
  "parse-units 100")
    printf '%s\n' "100000000"
    ;;
  *)
    echo "unexpected mock cast invocation: $*" >&2
    exit 1
    ;;
esac
