# Copy this file to .env and fill in local-only values.
# The matching .env file is ignored by Git.

# Foundry RPC endpoints.
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=

# Exact deployment inputs. Testnet is hard-blocked until an approved official
# source publishes a canonical proxy and that exact address is pinned in source.
# Leave ROBINHOOD_USDG_ADDRESS empty while the gate is blocked.
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_USDG_ADDRESS=
PROTOCOL_OWNER=
FEE_RECIPIENT=
DEPLOYER_ADDRESS=

# Post-deployment manifest inputs. The checker reads state only and must run on
# the manifest's captured block through an independent RPC.
DEPLOYMENT_MANIFEST_PATH=deployments/robinhood-testnet.json
DEPLOYED_FACTORY=
VALIDATION_TIER_OWNER=
VALIDATION_TIER_ADDRESS=
RENDERER_CREATION_BLOCK=
FACTORY_CREATION_BLOCK=
VALIDATION_TIER_CREATION_BLOCK=
FACTORY_DEPLOYMENT_TRANSACTION_HASH=
VALIDATION_TIER_CREATION_TRANSACTION_HASH=
OBSERVED_BLOCK_HASH=
RENDERER_VERIFICATION_URL=
FACTORY_VERIFICATION_URL=
DEPLOYER_VERIFICATION_URL=
CREATION_CODE_STORE_A_VERIFICATION_URL=
CREATION_CODE_STORE_B_VERIFICATION_URL=
VALIDATION_TIER_VERIFICATION_URL=

# Optional Blockscout verification credential, if the verifier requires one.
BLOCKSCOUT_API_KEY=

# Never put a deployer private key in this file. Import it into Foundry's
# encrypted keystore instead:
# cast wallet import backed-by-fans-testnet --interactive
