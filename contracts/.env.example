# Copy this file to .env and fill in local-only values.
# The matching .env file is ignored by Git.

# Foundry RPC endpoints.
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=

# Optional Blockscout verification credential, if the verifier requires one.
BLOCKSCOUT_API_KEY=

# Never put a deployer private key in this file. Import it into Foundry's
# encrypted keystore instead:
# cast wallet import backed-by-fans-testnet --interactive
